+package fakeip
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestLuminaCanReuseFrom(t *testing.T) {
+	memory := func(prefix string) *Pool {
+		pool, err := New(Options{IPNet: netip.MustParsePrefix(prefix), Size: 128})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return pool
+	}
+	a := memory("198.19.0.1/16")
+	b := memory("198.19.123.99/16")
+	if !b.CanReuseFrom(a) || !a.CanReuseFrom(a) {
+		t.Fatal("canonical same-prefix memory pools should be reusable")
+	}
+	if memory("198.18.0.1/16").CanReuseFrom(a) {
+		t.Fatal("different prefix must not reuse")
+	}
+	smaller, err := New(Options{IPNet: a.ipnet, Size: 64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if smaller.CanReuseFrom(a) || a.CanReuseFrom(smaller) {
+		t.Fatal("different memory capacity must not reuse")
+	}
+	v6 := memory("2001:db8:1::1/112")
+	if !memory("2001:db8:1::99/112").CanReuseFrom(v6) {
+		t.Fatal("canonical IPv6 prefix should be reusable")
+	}
+	if v6.CanReuseFrom(a) {
+		t.Fatal("different address family must not reuse")
+	}
+	// Store-kind checks do not open a database or use global persistence.
+	persistent := &Pool{ipnet: a.ipnet, store: &cachefileStore{}}
+	persistent2 := &Pool{ipnet: b.ipnet, store: &cachefileStore{}}
+	if persistent2.CanReuseFrom(persistent) {
+		t.Fatal("persistent pools must retain the legacy clone branch")
+	}
+	if persistent.CanReuseFrom(a) || a.CanReuseFrom(persistent) {
+		t.Fatal("persistence kind change must not reuse")
+	}
+	var absent *Pool
+	var nilMemory *memoryStore
+	var nilPersistent *cachefileStore
+	for _, invalid := range []*Pool{absent, {}, {ipnet: a.ipnet}, {ipnet: a.ipnet, store: nilMemory}, {ipnet: a.ipnet, store: nilPersistent}} {
+		if invalid.CanReuseFrom(a) || a.CanReuseFrom(invalid) {
+			t.Fatal("incomplete pool must not reuse")
+		}
+	}
+}
