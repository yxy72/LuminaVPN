+// CanReuseFrom reports whether the new configuration can keep the old memory pool.
+// Reusing the pool keeps its mutex, mappings and allocation cursor together,
+// including lookups by handlers that still reference the old DNS service.
+// The prefix, size and backing store are immutable after New returns.
+// Persistent pools retain the existing CloneFrom behavior: constructing a new
+// persistent pool can restore or flush its shared cache before PatchFrom runs.
+func (p *Pool) CanReuseFrom(o *Pool) bool {
+	if p == nil || o == nil || !p.ipnet.IsValid() || !o.ipnet.IsValid() || p.ipnet.Masked() != o.ipnet.Masked() || p.size != o.size {
+		return false
+	}
+	switch current := p.store.(type) {
+	case *memoryStore:
+		previous, ok := o.store.(*memoryStore)
+		return current != nil && ok && previous != nil
+	default:
+		return false
+	}
+}
