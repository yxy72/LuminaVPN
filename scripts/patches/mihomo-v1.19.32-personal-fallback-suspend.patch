diff --git a/component/dialer/lumina_fallback.go b/component/dialer/lumina_fallback.go
new file mode 100644
--- /dev/null
+++ b/component/dialer/lumina_fallback.go
@@ -0,0 +1,22 @@
+package dialer
+
+import (
+	"context"
+	"syscall"
+)
+
+type fallbackGuardKey struct{}
+
+// WithFallbackGuard carries the selector's lease check through address
+// resolution to the point where a direct socket is opened.
+func WithFallbackGuard(ctx context.Context, guard func() error) context.Context {
+	return context.WithValue(ctx, fallbackGuardKey{}, guard)
+}
+
+func fallbackSocketGuard(ctx context.Context) controlFn {
+	guard, _ := ctx.Value(fallbackGuardKey{}).(func() error)
+	if guard == nil {
+		return nil
+	}
+	return func(context.Context, string, string, syscall.RawConn) error { return guard() }
+}
