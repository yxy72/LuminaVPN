+	clock.Store(int64(time.Second))
+	now := func() time.Duration { return time.Duration(clock.Load()) }
+	control, err := newFallbackControlWithClock(now, "simulated-sleep")
+	if err != nil {
+		t.Fatal(err)
+	}
+	selector := &Selector{selected: "REJECT", fallback: control}
+	defer selector.RetireLuminaFallback()
+	initial, _ := selector.LuminaFallbackStatus()
+	request := LuminaFallbackRequest{initial.Revision, "open", initial.NowMS + maxLuminaFallback.Milliseconds()}
+	active, err := selector.SetLuminaFallback(request)
+	if err != nil || !active.Active {
+		t.Fatal("could not establish lease", active, err)
+	}
+	selector.selectionMu.Lock()
+	lease := control.lease
+	// Pause the ordinary Go timer to simulate that it is awaiting more
+	// active time, even when the system's sleep-inclusive clock has moved.
+	control.timer.Stop()
+	selector.selectionMu.Unlock()
+	work, pending, err := lease.enter(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pending.Close()
+	clock.Add(int64(maxLuminaFallback + time.Millisecond))
+	if work.Err() != nil {
+		t.Fatal("simulated sleep unexpectedly expired the Go context", work.Err())
+	}
+	if _, _, err := lease.enter(t.Context()); !errors.Is(err, errFallbackRevoked) {
+		t.Fatal("a new dial after wake retained authorization", err)
+	}
+	sentinel := errors.New("fallback called the physical dialer")
+	_, err = dialer.DialContext(work, "tcp4", "127.0.0.1:1", dialer.WithNetDialer(dialer.NetDialerFunc(
+		func(context.Context, string, string) (net.Conn, error) { return nil, sentinel })))
+	if !errors.Is(err, errFallbackRevoked) {
+		t.Fatal("a pending dial after wake retained authorization", err)
+	}
+	tcp := &fallbackTCPConn{use: pending}
+	udp := &fallbackPacketConn{use: pending}
+	if _, err := tcp.Read(nil); !errors.Is(err, errFallbackRevoked) {
+		t.Fatal("an existing TCP socket remained readable", err)
+	}
+	if _, err := udp.WriteTo(nil, nil); !errors.Is(err, errFallbackRevoked) {
+		t.Fatal("an existing UDP socket remained writable", err)
+	}
+	status, err := selector.LuminaFallbackStatus()
+	if err != nil || status.Active || status.Revision == active.Revision {
+		t.Fatal("old authority survived its elapsed deadline", status, err)
+	}
+	_, err = selector.SetLuminaFallback(LuminaFallbackRequest{active.Revision, "renew", status.NowMS + 1000})
+	if !errors.Is(err, ErrLuminaFallbackConflict) {
+		t.Fatal("a stale request survived wake", err)
+	}
+	if _, err := selector.SetLuminaFallback(LuminaFallbackRequest{status.Revision, "open", request.DeadlineMS}); !errors.Is(err, ErrLuminaFallbackDeadline) {
