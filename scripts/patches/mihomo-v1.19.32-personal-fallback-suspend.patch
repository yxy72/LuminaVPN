+package outboundgroup
+
+import (
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Unlike Go's Darwin timer clock, CLOCK_MONOTONIC_RAW includes system sleep.
+func fallbackMonotonicNow() time.Duration {
+	var stamp unix.Timespec
+	if err := unix.ClockGettime(unix.CLOCK_MONOTONIC_RAW, &stamp); err != nil {
+		return 0
+	}
+	return time.Duration(stamp.Nano())
+}
