diff --git a/hub/route/lumina_fallback.go b/hub/route/lumina_fallback.go
new file mode 100644
--- /dev/null
+++ b/hub/route/lumina_fallback.go
@@ -0,0 +1,67 @@
+package route
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+	"github.com/metacubex/mihomo/adapter/outboundgroup"
+	"github.com/metacubex/mihomo/hub/executor"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+func useLuminaFallback(w http.ResponseWriter, r *http.Request, action func(*outboundgroup.Selector) (outboundgroup.LuminaFallbackStatus, error)) {
+	var status outboundgroup.LuminaFallbackStatus
+	err := outboundgroup.ErrLuminaFallbackUnsupported
+	executor.WithConfigLock(func() {
+		if r.Context().Err() != nil {
+			err = outboundgroup.ErrLuminaFallbackConflict
+			return
+		}
+		if proxy := tunnel.CurrentProxy("PERSONAL"); proxy != nil {
+			if selector, ok := proxy.Adapter().(*outboundgroup.Selector); ok {
+				status, err = action(selector)
+			}
+		}
+	})
+	if err != nil {
+		code := http.StatusBadRequest
+		if errors.Is(err, outboundgroup.ErrLuminaFallbackConflict) {
+			code = http.StatusConflict
+		} else if errors.Is(err, outboundgroup.ErrLuminaFallbackUnsupported) {
+			code = http.StatusNotFound
+		}
+		render.Status(r, code)
+		render.JSON(w, r, newError(err.Error()))
+		return
+	}
+	render.JSON(w, r, status)
+}
+
+func getLuminaFallback(w http.ResponseWriter, r *http.Request) {
+	useLuminaFallback(w, r, (*outboundgroup.Selector).LuminaFallbackStatus)
+}
+
+func setLuminaFallback(w http.ResponseWriter, r *http.Request) {
+	const requestLimit = 1024
+	data, err := io.ReadAll(io.LimitReader(r.Body, requestLimit+1))
+	if err != nil || len(data) > requestLimit {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, ErrBadRequest)
+		return
+	}
+	var req outboundgroup.LuminaFallbackRequest
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&req) != nil || decoder.Decode(new(any)) != io.EOF {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, ErrBadRequest)
+		return
+	}
+	useLuminaFallback(w, r, func(s *outboundgroup.Selector) (outboundgroup.LuminaFallbackStatus, error) {
+		return s.SetLuminaFallback(req)
+	})
+}
